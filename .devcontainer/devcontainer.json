{
  "name": "T3 Code phone workspace",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "hostRequirements": { "cpus": 2 },
  "forwardPorts": [3773],
  "portsAttributes": {
    "3773": { "label": "T3 Code — pairing required", "onAutoForward": "silent", "protocol": "http" }
  },
  "postCreateCommand": "bash scripts/codespaces-setup.sh",
  "postStartCommand": "bash scripts/codespaces-start.sh",
  "customizations": {
    "vscode": { "settings": { "terminal.integrated.defaultProfile.linux": "bash" } }
  }
}
